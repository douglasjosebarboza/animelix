generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Anime {
  id            String   @id @default(cuid())
  anilistId     Int      @unique
  title         String
  coverImageUrl String?
  episodeCount  Int?
  seasonCount   Int?
  snapshotAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
