generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  watchEntries WatchEntry[]
}

model Anime {
  id            String   @id @default(cuid())
  anilistId     Int      @unique
  title         String
  coverImageUrl String?
  episodeCount  Int?
  seasonCount   Int?
  snapshotAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchEntries  WatchEntry[]
}

model WatchEntry {
  id               String   @id @default(cuid())
  userId           String
  animeId          String
  status           String   @default("watching")
  lastEpisodeSeason Int?
  lastEpisodeNumber Int?
  lastWatchedAt    DateTime?
  autoPauseEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime          Anime         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodeWatches EpisodeWatch[]

  @@unique([userId, animeId])
}

model EpisodeWatch {
  id          String   @id @default(cuid())
  watchEntryId String
  season      Int      @default(1)
  episode     Int
  watchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  watchEntry  WatchEntry @relation(fields: [watchEntryId], references: [id], onDelete: Cascade)

  @@unique([watchEntryId, season, episode])
}
