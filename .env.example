# Animelix environment variables — copy to .env.local and fill in.

# Neon Postgres (pooled connection — use for app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon Postgres (direct/unpooled connection — use for `prisma migrate`)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AniList GraphQL (no key required for public queries)
ANILIST_GRAPHQL_URL="https://graphql.anilist.co"

# Auto-pause threshold in days (WatchStatus engine)
AUTO_PAUSE_DAYS="30"
