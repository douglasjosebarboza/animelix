# Animelix environment variables — copy to .env.local and fill in.

# Neon Postgres (pooled connection — use for app runtime)
# `pgbouncer=true&connection_limit=1`: cada instância de serverless abre 1
# conexão só (o pool padrão do Prisma é num_cpus*2+1 e esgotaria o pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1"

# Neon Postgres (direct/unpooled connection — use for `prisma migrate`)
# É o `directUrl` do schema.prisma: o Prisma usa esta URL nas migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Auth.js / NextAuth
# AUTH_SECRET is the preferred name (NEXTAUTH_SECRET still works).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-with-node-crypto-randombytes-32-base64"
# AUTH_URL is the preferred name (NEXTAUTH_URL still works).
# In production this MUST be the public https URL of the app.
AUTH_URL="http://localhost:3000"
# Trust the host header. Vercel sets this automatically; set it explicitly
# when deploying anywhere else.
AUTH_TRUST_HOST="true"

# Upstash Redis (REST) — distributed rate limiting + cache de fallback.
# Required in production: without it the rate limits are per-instance and
# effectively multiplied by the number of running lambda instances.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://YOUR-ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR-UPSTASH-REDIS-TOKEN"

# AniList GraphQL endpoint (optional — defaults to the public AniList API).
# Useful for pointing the catalogue module at a stub server in tests.
ANILIST_GRAPHQL_URL="https://graphql.anilist.co"

# Rate limits (optional — defaults shown). See lib/limits.ts.
# RATE_LIMIT_LOGIN_PER_ACCOUNT="20"       # falhas por E-MAIL (sem IP) — anti brute force distribuído
# RATE_LIMIT_LOGIN_PER_ACCOUNT_IP="5"     # falhas por (IP, e-mail)
# RATE_LIMIT_LOGIN_PER_IP="20"            # falhas por IP
# RATE_LIMIT_LOGIN_WINDOW_MS="900000"     # 15 min
# RATE_LIMIT_REGISTER_PER_IP="5"          # registros por IP
# RATE_LIMIT_REGISTER_WINDOW_MS="3600000" # 1 h
# RATE_LIMIT_SEARCH_PER_IP="20"           # buscas por IP
# RATE_LIMIT_SEARCH_WINDOW_MS="60000"     # 1 min
# RATE_LIMIT_ANILIST_SEARCH_PER_MINUTE="25"  # buscas/min (limite da AniList: 90/min)
# RATE_LIMIT_ANILIST_DETAIL_PER_MINUTE="40"  # detalhes/min (limite da AniList: 90/min)
# A soma das duas cotas da AniList precisa ficar abaixo de 90/min: estourar
# isso faz a Vercel banir o IP do app e derruba o site inteiro.
